package com.micro.products.exceptions.handler;

import com.finnazen.springbootapirestbacked.exceptions.model.ExceptionGeneral;
import com.finnazen.springbootapirestbacked.exceptions.type.UserException;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.ResponseStatus;
import org.springframework.web.bind.annotation.RestControllerAdvice;

@RestControllerAdvice
public class GlobalExceptionHandler {


    @ResponseStatus(HttpStatus.BAD_REQUEST)
    @ExceptionHandler(value = UserException.class)
    public final ResponseEntity<String>handleUserException(final UserException userException){
        ExceptionGeneral exceptionGeneral = ExceptionGeneral.builder().build();
        return new ResponseEntity<>(userException.getMessage(), HttpStatus.BAD_REQUEST);

    }
}
